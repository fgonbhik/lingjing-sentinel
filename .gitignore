# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
**/dist/
/.wrangler/
/outputs/
/work/
/deliverables/

# local Codex/skill/reference caches
/.agents/
/.pnpm-store/
/.reference/
/runtime/
/skills-lock.json
/audit/

# generated development caches
**/__pycache__/
*.pyc
*.tsbuildinfo
